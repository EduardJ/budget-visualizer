    { "id": "wages", "color": "#2e7d6b", "name": { "sq": "Paga dhe shtesa", "en": "Wages and salaries" } },
    { "id": "goods", "color": "#6f5aa8", "name": { "sq": "Mallra dhe shërbime", "en": "Goods and services" } },
    { "id": "util", "color": "#8a8a2e", "name": { "sq": "Shpenzime komunale", "en": "Utilities" } },
    { "id": "subs", "color": "#c2563a", "name": { "sq": "Subvencione dhe transfere", "en": "Subsidies and transfers" } },
    { "id": "capital", "color": "#2f7fb8", "name": { "sq": "Investime kapitale", "en": "Capital investment" } },
    { "id": "reserve", "color": "#8a8f99", "name": { "sq": "Rezerva", "en": "Reserves" } },
    { "id": "interest", "color": "#6b4e3d", "name": { "sq": "Interesi", "en": "Interest" } },
    { "id": "donor", "color": "#9c6ba0", "name": { "sq": "Grante të donatorëve", "en": "Donor grants" } }
