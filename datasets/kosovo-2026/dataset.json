    { "id": "municipal", "label": "municipal", "sections": ["municipal"], "nodes": ["dest:local"] }
  ],
  "chunks": { "central": ["central"], "municipal": ["municipal"], "capital": ["capital"] },
  "tabs": [
    {
      "id": "flow", "layout": "sankey", "title": "s1", "width": 3200, "height": 1500,
      "columns": [
        { "x": 380, "header": "in", "labelSide": "left",
          "nodes": ["rev:vatbor", "rev:vatdom", "rev:excise", "rev:pit", "rev:cit", "rev:customs", "rev:prop", "rev:dother", "rev:iother", "rev:feesc", "rev:feesl", "rev:conc", "rev:mining", "rev:divid", "rev:intinc", "rev:gbs", "rev:gdon", "fin:dbs", "fin:projl06", "fin:projl04", "fin:onl_in", "fin:refin_in", "fin:newsec", "fin:repay_in"] },
        { "x": 860, "header": "grp", "nodes": ["grp:taxgross", "rev:nontax", "rev:grants", "fin:extin", "fin:domin"] },
        { "x": 1280, "header": "pool", "nodes": ["pool", "rev:refunds"] },
        { "x": 1680, "header": "uses", "nodes": ["budget", "dest:donor", "fin:principal", "fin:domout", "fin:bank", "pool/diff"] },
        { "x": 2120, "header": "dest", "nodes": ["dest:central", "dest:local", "dest:interest", "fin:refin_out", "fin:onl_out", "fin:lend", "fin:capz", "fin:ifi"] },
        { "x": 2580, "header": "cats", "labelWidth": 420, "headerWidth": 420,
          "nodes": ["cat:subs", "cat:capital", "cat:wages", "cat:goods", "cat:util", "cat:reserve", "cat:interest", "cat:donor", "dest:central/diff", "dest:local/diff"] }
      ]
    },
    { "id": "central", "layout": "cards", "title": "s2", "chunk": "central", "kind": "org", "columns": 8 },
    {
      "id": "municipal", "layout": "cards", "title": "s3", "chunk": "municipal", "kind": "municipality", "columns": 8, "note": "noPop",
      "sort": [
        { "id": "amount", "label": "byAmount" },
        { "id": "name", "label": "byName" },
        { "id": "wages", "label": "byWages", "share": "wages" },
        { "id": "capital", "label": "byCapital", "share": "capital" }
      ]
    },
    { "id": "capital", "layout": "ranking", "title": "s4", "chunk": "capital", "kind": "project", "top": 150, "perColumn": 50, "category": "capital" },
    { "id": "findings", "layout": "checks", "title": "s5" }
